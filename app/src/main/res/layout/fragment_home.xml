<?xml version="1.0" encoding="utf-8"?>
<!--suppress AndroidUnresolvableTag -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/innerConstraint"
        android:layout_width="950dp"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.444"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/toolbar"
            android:layout_width="436dp"
            android:layout_height="44dp"
            android:layout_marginTop="-10dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.63"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.157" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/content_view"
        android:name="org.jellyfin.androidtv.ui.home.HomeRowsFragment"
        android:layout_width="974dp"
        android:layout_height="0dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="1dp"
        android:contentDescription="@string/home_content_description"
        android:descendantFocusability="afterDescendants"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/innerConstraint"
        tools:ignore="VisualLintBounds"
        tools:layout_marginStart="-70dp">

        <requestFocus />
    </androidx.fragment.app.FragmentContainerView>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/carousel_container"
        android:layout_width="930dp"
        android:layout_height="259dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="53dp"
        android:layout_marginEnd="24dp"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

    </androidx.compose.ui.platform.ComposeView>

    <!-- Info about the focused item; replaces the carousel while browsing rows -->
    <LinearLayout
        android:id="@+id/info_panel"
        android:layout_width="930dp"
        android:layout_height="259dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="53dp"
        android:layout_marginEnd="24dp"
        android:alpha="0"
        android:focusable="false"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingBottom="16dp"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <org.jellyfin.androidtv.ui.AsyncImageView
            android:id="@+id/logo"
            android:layout_width="325dp"
            android:layout_height="85dp"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/title"
            android:layout_width="521dp"
            android:layout_height="38dp"
            android:ellipsize="end"
            android:fontFamily="@font/bebas_neue"
            android:letterSpacing="0.02"
            android:lineSpacingExtra="1dp"
            android:maxLines="1"
            android:text=""
            android:textAllCaps="true"
            android:textColor="@color/basic_button_text"
            android:textSize="31sp"
            android:textStyle="bold"
            android:typeface="monospace" />

        <LinearLayout
            android:id="@+id/infoRow"
            android:layout_width="500dp"
            android:layout_height="20dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <org.jellyfin.androidtv.ui.shared.ShadowedTextView
            android:id="@+id/summary"
            android:layout_width="520dp"
            android:layout_height="74dp"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:justificationMode="inter_word"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:paddingEnd="14dp"
            android:text=""
            android:textAlignment="viewStart"
            android:textSize="15sp"
            android:typeface="monospace" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
